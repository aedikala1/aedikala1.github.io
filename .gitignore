_site/
.sass-cache/
.jekyll-cache/
.jekyll-metadata
.bundle/
vendor/
.DS_Store

# Raw working notes stay on this machine. The public write-ups live in
# published/. Keep both guards: this protects notes from Git, while
# _config.yml also protects them from the generated site.
/private-notes/**
!/private-notes/README.md
!/private-notes/.gitignore
